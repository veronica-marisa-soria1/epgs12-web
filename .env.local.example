# Copiar este archivo a ".env.local" para que el sitio use el backend
# real (Django) en vez de los datos de ejemplo de src/data/*.ts.
# Sin este archivo, el sitio sigue funcionando con datos de ejemplo.

# En desarrollo local, con el backend corriendo (ver epgs12-backend/README.md):
VITE_API_URL=http://127.0.0.1:8000

# En producción, la URL del backend ya desplegado, ej:
# VITE_API_URL=https://epgs12-backend.up.railway.app
